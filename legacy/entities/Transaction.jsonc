{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "finger_to_machine",
        "finger_to_phone",
        "top_up"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green"
      ],
      "default": "finger_to_machine"
    },
    "counterparty": {
      "type": "string"
    },
    "counterparty_handle": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "status": {
      "type": "string",
      "enum": [
        "authorised",
        "declined",
        "pending"
      ],
      "enumColors": [
        "green",
        "red",
        "yellow"
      ],
      "default": "pending"
    },
    "biometric_verified": {
      "type": "boolean",
      "default": false
    },
    "match_score": {
      "type": "number"
    },
    "result_code": {
      "type": "string"
    },
    "identity_reference": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}